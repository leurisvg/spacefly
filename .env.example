# Public URL where SpaceFly is served (used for the OAuth redirect and cookie security).
# For local development with `npm run dev` use http://localhost:4200
APP_URL=https://spacefly.tu-dominio.com
PORT=3000

# Firefly III: internal URL (Docker network) for API calls, public URL for the browser OAuth redirect.
FIREFLY_INTERNAL_URL=http://firefly:8080
FIREFLY_PUBLIC_URL=https://firefly.tu-dominio.com

# OAuth client created in Firefly → Options → Profile → OAuth → Create new client
# Redirect URL: ${APP_URL}/auth/callback   (confidential client)
FIREFLY_OAUTH_CLIENT_ID=
FIREFLY_OAUTH_CLIENT_SECRET=

# 32+ random bytes, e.g. `openssl rand -base64 48`
SESSION_SECRET=
SESSION_TTL_DAYS=30

# Cloudflare Zero Trust (Access) JWT validation. Set to false only for local development.
CF_ACCESS_ENABLED=true
CF_ACCESS_TEAM_DOMAIN=tu-team.cloudflareaccess.com
CF_ACCESS_AUD=
CF_ACCESS_ALLOWED_EMAILS=leurisvg003@gmail.com
# Mobile app (optional). Client ID of the Access service token the app sends (the secret is typed in the app's settings,
# never stored on the server). Service tokens only reach /api/*, /auth/mobile/token and /auth/logout.
# CF_ACCESS_SERVICE_TOKEN_IDS=xxxxxxxx.access

# Mobile app login (optional): the redirect URIs the app may be sent back to after signing in, comma-separated and
# case-sensitive. Empty disables the mobile endpoints (/auth/mobile/*).
# MOBILE_REDIRECT_URIS=spacefly://auth/callback

# Currencies offered in the currency toggle (the Firefly primary currency is always included).
DISPLAY_CURRENCIES=DOP,USD
# Fallback when your Firefly instance has no exchange rate for a date: open.er-api | none
FX_FALLBACK_PROVIDER=open.er-api

# Cache TTL (seconds) for the current month; closed months are cached for a week.
CACHE_TTL_CURRENT_MONTH=300

# Volume for SQLite (sessions, cache, settings, fallback rates).
DATA_DIR=/data

# Development only (ignored when NODE_ENV=production): skip OAuth using a Personal Access Token.
# DEV_FIREFLY_TOKEN=
