{
  "name": "space-fly",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "dev": "concurrently -k -n web,api -c cyan,magenta \"npm:dev:web\" \"npm:dev:server\"",
    "dev:web": "ng serve",
    "dev:server": "tsx watch --tsconfig server/tsconfig.json --env-file-if-exists=.env server/src/main.ts",
    "build": "ng build && npm run build:server",
    "build:server": "cd server && tsup",
    "start": "node dist/server/main.mjs",
    "test": "ng test --watch=false && npm run test:server",
    "test:web": "ng test",
    "test:server": "vitest run --config server/vitest.config.ts",
    "typecheck:server": "tsc -p server/tsconfig.json",
    "lint": "ng lint",
    "fixtures:capture": "tsx --tsconfig server/tsconfig.json --env-file-if-exists=.env server/scripts/capture-fixtures.ts",
    "dev:mock": "concurrently -k -n mock,api,web -c yellow,magenta,cyan \"npm:mock:firefly\" \"npm:dev:server:mock\" \"npm:dev:web\"",
    "dev:server:mock": "tsx watch --tsconfig server/tsconfig.json --env-file=.env.mock server/src/main.ts",
    "mock:firefly": "tsx --tsconfig server/tsconfig.json server/scripts/mock-firefly.ts"
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/cdk": "^22.2.1",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@hono/node-server": "^2.1.3",
    "@jsverse/transloco": "^8.4.0",
    "@ng-icons/core": "^36.1.0",
    "@ng-icons/lucide": "^36.1.0",
    "@spartan-ng/brain": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "echarts": "^6.1.0",
    "hono": "^4.13.12",
    "jose": "^6.2.12",
    "lru-cache": "^11.5.3",
    "luxon": "^3.7.2",
    "ngx-echarts": "^22.0.0",
    "ngx-scrollbar": "^19.1.5",
    "rxjs": "~7.8.0",
    "tailwind-merge": "^3.7.0",
    "tslib": "^2.3.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@angular/build": "^22.2.1",
    "@angular/cli": "^22.2.1",
    "@angular/compiler-cli": "^22.2.0",
    "@eslint/js": "^10.0.1",
    "@spartan-ng/cli": "^1.5.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.4",
    "angular-eslint": "22.5.0",
    "concurrently": "^10.0.5",
    "eslint": "^10.9.1",
    "jsdom": "^30.0.0",
    "postcss": "^8.5.28",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.69.0",
    "vitest": "^5.0.0"
  }
}
