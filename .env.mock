# Local demo against the mock Firefly (npm run dev:mock). Not secrets — do not use in production.
NODE_ENV=development
APP_URL=http://localhost:4200
PORT=3000
FIREFLY_INTERNAL_URL=http://localhost:8081
FIREFLY_PUBLIC_URL=http://localhost:8081
FIREFLY_OAUTH_CLIENT_ID=mock
SESSION_SECRET=mock-session-secret-not-for-production-use-0123456789
CF_ACCESS_ENABLED=false
DEV_FIREFLY_TOKEN=mock-token
FX_FALLBACK_PROVIDER=none
DATA_DIR=./data/mock
MOBILE_REDIRECT_URIS=spacefly://auth/callback
